# Copy to .env and fill in.
JWT_SECRET=change-this-to-a-long-random-string
# LLM (required for narration and the chat agent; the planner still works without it)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional: with a key, ratings and review counts come from Google Places (New).
# Without it, the app uses OpenStreetMap (no ratings; popularity is estimated).
GOOGLE_PLACES_API_KEY=
# Local run only (docker-compose sets its own):
DATABASE_URL=postgresql+psycopg://tourist:tourist@localhost:5432/tourist
